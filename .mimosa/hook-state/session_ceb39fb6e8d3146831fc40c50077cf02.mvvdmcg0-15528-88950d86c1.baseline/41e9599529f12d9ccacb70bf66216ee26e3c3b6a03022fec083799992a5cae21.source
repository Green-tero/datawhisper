name: DataWhisper Data Audit

# Autonomous PR governor. On pull requests that touch SQL assets, migrations or
# embedded/columnar datasets it computes schema drift, flags PII exposure in new
# columns, detects query-plan regressions and upserts one sticky report.
on:
  pull_request:
    paths:
      - "**.sql"
      - "**.sqlite"
      - "**.sqlite3"
      - "**.duckdb"
      - "**.parquet"
      - "**.jsonl"
      - "**.ndjson"
      - "migrations/**"
      - "db/**"
      - "seeds/**"

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: datawhisper-audit-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  audit:
    name: Zero-trust data & schema audit
    runs-on: ubuntu-latest
    steps:
      - name: Check out full history (base and head revisions)
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install DataWhisper
        run: pip install -e ".[duckdb,arrow]"

      - name: Run governance audit (headless)
        env:
          DATAWHISPER_GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Optional: enables the agentic insight layer. Without it, the audit
          # still runs fully deterministic (drift + PII + plan benchmarks).
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          # Stable salt keeps hashed PII pseudonyms consistent across runs.
          DW_PII_SALT: ${{ secrets.DW_PII_SALT }}
        run: |
          datawhisper audit \
            --ci-audit \
            --repo "${{ github.repository }}" \
            --pr "${{ github.event.pull_request.number }}" \
            --base-ref "${{ github.base_ref }}" \
            --head-ref "${{ github.event.pull_request.head.sha }}" \
            --fail-on-regression

      - name: Upload interactive Plotly report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: datawhisper-audit-report
          path: datawhisper-report/
          if-no-files-found: ignore
